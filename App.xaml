<Application x:Class="MirrorFlux.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:MirrorFlux.Services"
             StartupUri="Views/MainWindow.xaml">
  <!-- アプリ全体で共有する色・スタイルの定義。各色はINIのテーマ設定で上書きできる。 -->
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <services:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

    <!-- 基本の配色。パネル・ログ・ファンクションキー欄の色。 -->
    <SolidColorBrush x:Key="ScreenBackground" Color="#000000" />
    <SolidColorBrush x:Key="PanelBackground" Color="#000000" />
    <SolidColorBrush x:Key="PrimaryText" Color="#8494FC" />
    <SolidColorBrush x:Key="PaneText" Color="#D8D8D8" />
    <SolidColorBrush x:Key="MutedText" Color="#605898" />
    <SolidColorBrush x:Key="AccentText" Color="#8494FC" />
    <SolidColorBrush x:Key="HighlightText" Color="#8494FC" />
    <SolidColorBrush x:Key="DarkPurpleBackground" Color="#19112E" />
    <SolidColorBrush x:Key="DarkPurpleHighlight" Color="#382860" />
    <SolidColorBrush x:Key="DarkPurpleShadow" Color="#0C0818" />
    <SolidColorBrush x:Key="InactiveBorder" Color="#302858" />
    <SolidColorBrush x:Key="MarkColor" Color="#4A4D4E" />
    <SolidColorBrush x:Key="MarkForeground" Color="#D8D8D8" />
    <SolidColorBrush x:Key="LogBackground" Color="#000000" />
    <SolidColorBrush x:Key="FunctionBarBackground" Color="#000000" />
    <SolidColorBrush x:Key="FunctionButtonBackground" Color="#B0B0B0" />
    <SolidColorBrush x:Key="FunctionButtonForeground" Color="#000000" />
    <!-- ダイアログ・ビューア・アイコン・音楽プレイヤーの表示色。%theme_<key> ですべて上書きできる。 -->
    <SolidColorBrush x:Key="InteractionHoverBackground" Color="#121828" />
    <SolidColorBrush x:Key="InteractionSelectionBackground" Color="#202A48" />
    <SolidColorBrush x:Key="DialogBackground" Color="#000000" />
    <SolidColorBrush x:Key="DialogInsetBackground" Color="#181831" />
    <SolidColorBrush x:Key="ErrorText" Color="#FF8888" />
    <SolidColorBrush x:Key="ViewerBlack" Color="#000000" />
    <SolidColorBrush x:Key="ViewerWhite" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ViewerChromeBackground" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ViewerChromeBorder" Color="#383838" />
    <SolidColorBrush x:Key="ViewerBadgeBackground" Color="#CC19112E" />
    <SolidColorBrush x:Key="TextViewerBackground" Color="#0D101A" />
    <SolidColorBrush x:Key="TextMinimapBackground" Color="#090C14" />
    <SolidColorBrush x:Key="DirectoryText" Color="#C8D4FF" />
    <SolidColorBrush x:Key="IconDirectory" Color="#AAB6FF" />
    <SolidColorBrush x:Key="IconDefault" Color="#758496" />
    <SolidColorBrush x:Key="IconScript" Color="#20C287" />
    <SolidColorBrush x:Key="IconMarkdown" Color="#3F9CE8" />
    <SolidColorBrush x:Key="IconProject" Color="#9F5FD8" />
    <SolidColorBrush x:Key="IconGit" Color="#E25A45" />
    <SolidColorBrush x:Key="IconArchive" Color="#D89830" />
    <SolidColorBrush x:Key="IconImage" Color="#D85888" />
    <SolidColorBrush x:Key="IconMusic" Color="#00FF66" />
    <SolidColorBrush x:Key="MusicBorder" Color="#404064" />
    <SolidColorBrush x:Key="MusicText" Color="#C8C8E8" />
    <SolidColorBrush x:Key="MusicMuted" Color="#605898" />
    <SolidColorBrush x:Key="MusicKeyboardWhiteKey" Color="#888894" />
    <SolidColorBrush x:Key="MusicKeyboardWhiteBorder" Color="#3C3C48" />
    <SolidColorBrush x:Key="MusicKeyboardBlackKey" Color="#202028" />
    <SolidColorBrush x:Key="MusicKeyLamp" Color="#00E840" />
    <SolidColorBrush x:Key="MusicKeyLampNd" Color="#00E5FF" />
    <SolidColorBrush x:Key="MusicInactiveWhiteKey" Color="#303038" />
    <SolidColorBrush x:Key="MusicInactiveWhiteBorder" Color="#202028" />
    <SolidColorBrush x:Key="MusicInactiveBlackKey" Color="#101018" />
    <SolidColorBrush x:Key="MusicCyan" Color="#60C8F0" />
    <SolidColorBrush x:Key="MusicAmber" Color="#E0B860" />
    <SolidColorBrush x:Key="MusicMeterOff" Color="#101032" />
    <SolidColorBrush x:Key="MusicMeterLit" Color="#8282FA" />
    <SolidColorBrush x:Key="MusicMeterPeak" Color="#6060C4" />
    <SolidColorBrush x:Key="MusicMeterEndpoint" Color="#5757B4" />
    <SolidColorBrush x:Key="MusicPanRing" Color="#686872" />
    <SolidColorBrush x:Key="MusicPanDot" Color="#B0B0BC" />
    <SolidColorBrush x:Key="MusicWaveformBackground" Color="#0A0A16" />
    <SolidColorBrush x:Key="MusicWaveformIdle" Color="#466482" />
    <SolidColorBrush x:Key="MusicDim" Color="#14142B" />
    <SolidColorBrush x:Key="MusicTransportHover" Color="#AAB6FF" />
    <SolidColorBrush x:Key="MusicTransportHoverMuted" Color="#857DBA" />
    <SolidColorBrush x:Key="MusicTransportTrail1" Color="#7282E0" />
    <SolidColorBrush x:Key="MusicTransportTrail2" Color="#5C6CB8" />
    <SolidColorBrush x:Key="MusicTransportTrail3" Color="#485594" />
    <SolidColorBrush x:Key="MiniPlayerBorder" Color="#606080" />
    <SolidColorBrush x:Key="MiniPlayerButtonBackground" Color="#101024" />
    <SolidColorBrush x:Key="MiniPlayerButtonForeground" Color="#A8A8FF" />
    <SolidColorBrush x:Key="MiniPlayerButtonBorder" Color="#444478" />
    <SolidColorBrush x:Key="MiniPlayerButtonHover" Color="#282858" />
    <SolidColorBrush x:Key="MusicSevenSegment" Color="#A4A4CE" />


    <!-- ダイアログの一覧項目の共通スタイル。選択中は下線カーソルと紺色の背景で示す。 -->
    <Style x:Key="RetroDialogListBoxItemStyle" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="ItemBg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
              <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True" />
              <Border x:Name="CursorLine"
                      Height="1.5"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      SnapsToDevicePixels="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource InteractionHoverBackground}" />
                <Setter TargetName="CursorLine" Property="Background" Value="{DynamicResource InactiveBorder}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource InteractionSelectionBackground}" />
                <Setter TargetName="CursorLine" Property="Background" Value="{DynamicResource HighlightText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ダイアログの入力欄の共通スタイル。 -->
    <Style x:Key="RetroDialogTextBoxStyle" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource DialogBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PaneText}" />
      <Setter Property="CaretBrush" Value="{DynamicResource HighlightText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HighlightText}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Height" Value="24" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontFamily" Value="Consolas, BIZ UDGothic, MS Gothic" />
      <Setter Property="SelectionBrush" Value="{DynamicResource HighlightText}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- [Y] / [N] などのキー表示枠の共通スタイル。 -->
    <Style x:Key="RetroKeyBadgeBorder" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource DarkPurpleBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InactiveBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- スクロールバーのつまみ。Windows標準の装飾を使わず、両端を丸めた細い棒にする。 -->
    <Style x:Key="MinimalScrollThumb" TargetType="{x:Type Thumb}">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Border x:Name="thumbBorder"
                    Background="{DynamicResource InactiveBorder}"
                    CornerRadius="3"
                    Margin="1" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource AccentText}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource HighlightText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- アプリ全体のスクロールバー。幅6px、矢印ボタンなし。 -->
    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="6" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ScrollBar}">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                    Opacity="0" Focusable="False" IsTabStop="False" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource MinimalScrollThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                    Opacity="0" Focusable="False" IsTabStop="False" />
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="6" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ScrollBar}">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                    Opacity="0" Focusable="False" IsTabStop="False" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource MinimalScrollThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                    Opacity="0" Focusable="False" IsTabStop="False" />
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ファンクションキー欄のボタン。平らな四角で、ホバー時は白く反転する。 -->
    <Style x:Key="RetroFunctionButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource FunctionButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource FunctionButtonForeground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="{x:Null}" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="btnBorder"
                    Background="{TemplateBinding Background}"
                    BorderThickness="0"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ViewerWhite}" />
                <Setter Property="Foreground" Value="{DynamicResource ViewerBlack}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource FunctionButtonBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource ViewerBlack}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>

