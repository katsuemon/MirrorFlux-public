<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="INI" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
 <Color name="Comment" foreground="#808CA8"/>
 <Color name="Section" foreground="#D0B2F5" fontWeight="bold"/>
 <Color name="Key" foreground="#85CDE0"/>
 <Color name="String" foreground="#E8B887"/>
 <Color name="Number" foreground="#99C8F0"/>
 <RuleSet>
  <Span color="Comment" begin="^\s*[;#]"/>
  <Rule color="Section">^\s*\[[^\]\r\n]+\]</Rule>
  <Rule color="Key">^\s*[^=:\s#;]+(?=\s*(?:=|:))</Rule>
  <Span color="String" begin="&quot;" end="&quot;"><RuleSet><Span begin="\\" end="."/></RuleSet></Span>
  <Span color="String" begin="'" end="'"/>
  <Rule color="Number">\b(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\.[0-9]+)?)\b</Rule>
 </RuleSet>
</SyntaxDefinition>
