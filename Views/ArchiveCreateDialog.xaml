<controls:RetroDialogWindow x:Class="MirrorFlux.ArchiveCreateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MirrorFlux.Controls"
    Title="アーカイブ作成" Width="550" Foreground="{DynamicResource PaneText}"
    Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
  <!-- アーカイブ作成ダイアログ。形式・ファイル名・圧縮率を選ぶ。 -->
  <controls:RetroDialogWindow.Resources>
    <!-- 選択肢ボタン。Tagが真のとき選択中として強調する。 -->
    <Style x:Key="ChoiceButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PaneText}" />
      <Setter Property="Background" Value="{DynamicResource DialogBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InactiveBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1.5" />
      <Setter Property="Padding" Value="2,2" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="True">
          <Setter Property="Background" Value="{DynamicResource InteractionSelectionBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource HighlightText}" />
          <Setter Property="Foreground" Value="{DynamicResource HighlightText}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Background" Value="{DynamicResource InteractionSelectionBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource HighlightText}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </controls:RetroDialogWindow.Resources>
  <Border BorderBrush="{DynamicResource HighlightText}" BorderThickness="2" Background="{DynamicResource DialogBackground}">
    <DockPanel>
      <controls:RetroDialogHeader DockPanel.Dock="Top" TitleText="アーカイブ作成" />
      <StackPanel Margin="18,12,18,14">
        <TextBlock x:Name="CountText" Foreground="{DynamicResource MutedText}" Margin="0,0,0,9" />
        <!-- 形式・ファイル名・圧縮率の入力欄。 -->
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/></Grid.RowDefinitions>
          <TextBlock Text="形式" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ZipButton" Style="{StaticResource ChoiceButton}" Width="70" Content="ZIP" Click="Format_Click"/>
            <Button x:Name="SevenZipButton" Style="{StaticResource ChoiceButton}" Width="70" Content="7Z" Click="Format_Click"/>
            <Button x:Name="LzhButton" Style="{StaticResource ChoiceButton}" Width="70" Content="LZH" Click="Format_Click"/>
            <Button x:Name="TarButton" Style="{StaticResource ChoiceButton}" Width="70" Content="TAR" Click="Format_Click"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="ファイル名" VerticalAlignment="Center"/>
          <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource RetroDialogTextBoxStyle}"
                   VerticalAlignment="Center"/>
          <TextBlock Grid.Row="2" Text="圧縮率" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel x:Name="ZipLevelPanel" Orientation="Horizontal">
              <Button x:Name="LevelNone" Style="{StaticResource ChoiceButton}" Width="80" Content="無圧縮" Click="Level_Click"/>
              <Button x:Name="LevelFast" Style="{StaticResource ChoiceButton}" Width="80" Content="高速" Click="Level_Click"/>
              <Button x:Name="LevelStandard" Style="{StaticResource ChoiceButton}" Width="80" Content="標準" Click="Level_Click"/>
              <Button x:Name="LevelHigh" Style="{StaticResource ChoiceButton}" Width="80" Content="高圧縮" Click="Level_Click"/>
            </StackPanel>
            <Button x:Name="FixedLevelButton" Style="{StaticResource ChoiceButton}" Width="190"
                    Visibility="Collapsed" IsTabStop="False" Click="FixedLevel_Click"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,6,0,0"/>
        <Border Height="1" Background="{DynamicResource InactiveBorder}" Margin="0,10,0,6"/>
        <!-- 注意書きと作成・中止ボタン、下部のキーヘルプ。 -->
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="FormatNoticeText" Grid.Column="0" Text="LZHの名前はCP932対応文字のみです。"
                     Foreground="{DynamicResource ErrorText}" VerticalAlignment="Center"
                     Visibility="Collapsed"/>
          <Button x:Name="ApplyButton" Grid.Column="1" Style="{StaticResource ChoiceButton}" Content="作成" Width="90"
                  Margin="0,0,6,0" Click="Apply_Click"/>
          <Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource ChoiceButton}" Content="中止" Width="90"
                  IsCancel="True"/>
        </Grid>
        <controls:RetroDialogKeyHelp Text="[↑↓] 項目移動  [←→] 選択  [Enter] 作成  [Esc] 中止" Margin="0,8,0,0"/>
      </StackPanel>
    </DockPanel>
  </Border>
</controls:RetroDialogWindow>
