<controls:RetroDialogWindow x:Class="MirrorFlux.PathInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MirrorFlux.Controls"
        Title="ディレクトリ移動"
        Width="540"
        Foreground="{DynamicResource PaneText}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

  <!-- 移動先のパスを直接入力するダイアログ。外枠は2pxの強調色で囲む。 -->
  <Border BorderBrush="{DynamicResource HighlightText}" BorderThickness="2" Background="{DynamicResource DialogBackground}" Padding="0">
    <DockPanel LastChildFill="True">

      <!-- 共通のダイアログ見出し。横幅いっぱいに置く。 -->
      <controls:RetroDialogHeader DockPanel.Dock="Top" TitleText="change directory" />

      <!-- 本文。 -->
      <StackPanel Margin="16,12,16,14">
        <!-- 入力の案内と、指定できるパスの例。 -->
        <TextBlock Text="移動先のフォルダーまたはアーカイブのパスを入力してください:"
                   Foreground="{DynamicResource PaneText}"
                   FontSize="14"
                   Margin="0,0,0,4" />

        <TextBlock Text="※ \\server\share などのネットワーク共有や [...] を含むフォルダー、.zip も指定できます"
                   Foreground="{DynamicResource MutedText}"
                   FontSize="11"
                   Margin="0,0,0,8" />

        <!-- パスの入力欄。1pxの強調色で囲む。 -->
        <Border BorderBrush="{DynamicResource HighlightText}"
                BorderThickness="1"
                Background="{DynamicResource DialogBackground}"
                Margin="0,0,0,8"
                SnapsToDevicePixels="True">
          <TextBox x:Name="PathTextBox"
                   Background="{DynamicResource DialogBackground}"
                   Foreground="{DynamicResource PaneText}"
                   CaretBrush="{DynamicResource HighlightText}"
                   SelectionBrush="{DynamicResource HighlightText}"
                   BorderThickness="0"
                   Height="26"
                   Padding="6,2"
                   FontSize="14"
                   FontFamily="Consolas, BIZ UDGothic, MS Gothic"
                   TextChanged="PathTextBox_TextChanged"
                   SnapsToDevicePixels="True" />
        </Border>

        <!-- エラーの表示欄。 -->
        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource AccentText}"
                   FontSize="12"
                   Margin="0,0,0,8"
                   Visibility="Collapsed"
                   TextWrapping="Wrap" />

        <!-- 下部のキーヘルプ。 -->
        <controls:RetroDialogKeyHelp Text="[Enter] 決定  [Esc] 中止" />
      </StackPanel>
    </DockPanel>
  </Border>
</controls:RetroDialogWindow>
