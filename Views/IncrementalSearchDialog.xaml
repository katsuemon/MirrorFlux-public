<controls:RetroDialogWindow x:Class="MirrorFlux.IncrementalSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MirrorFlux.Controls"
    Title="絞り込み" Width="480" Foreground="{DynamicResource PaneText}"
    Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
  <!-- ファイル一覧の絞り込みダイアログ。入力欄、一致件数、下部のキーヘルプを並べる。 -->
  <Border BorderBrush="{DynamicResource HighlightText}" BorderThickness="2" Background="{DynamicResource DialogBackground}">
    <DockPanel>
      <controls:RetroDialogHeader DockPanel.Dock="Top" TitleText="絞り込み" />
      <StackPanel Margin="16,12,16,14">
        <TextBlock Text="ファイル・フォルダー名を入力してください:" Margin="0,0,0,8"/>
        <TextBox x:Name="SearchBox" Style="{StaticResource RetroDialogTextBoxStyle}"
                 TextChanged="SearchBox_TextChanged" Height="27"/>
        <TextBlock x:Name="ResultText" Foreground="{DynamicResource MutedText}"
                   Margin="0,8,0,8" TextTrimming="CharacterEllipsis"/>
        <controls:RetroDialogKeyHelp Text="[入力] 一覧を絞り込み  [Enter] 決定  [Esc] 元に戻す"/>
      </StackPanel>
    </DockPanel>
  </Border>
</controls:RetroDialogWindow>
