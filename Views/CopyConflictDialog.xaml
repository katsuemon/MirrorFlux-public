<controls:RetroDialogWindow x:Class="MirrorFlux.CopyConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MirrorFlux.Controls"
        Title="上書き確認 (同名ファイルが存在します)"
        Width="460"
        Foreground="{DynamicResource PaneText}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

  <!-- コピー・移動先に同名ファイルがあるときの上書き確認ダイアログ。外枠は2pxの強調色で囲む。 -->
  <Border BorderBrush="{DynamicResource HighlightText}" BorderThickness="2" Background="{DynamicResource DialogBackground}" Padding="0">
    <DockPanel LastChildFill="True">

      <!-- 共通のダイアログ見出し。横幅いっぱいに置く。 -->
      <controls:RetroDialogHeader DockPanel.Dock="Top" TitleText="上書き確認 (同名ファイルが存在します)" />

      <StackPanel Margin="12,8,12,10">

        <!-- 競合しているファイルの情報。 -->
        <StackPanel Margin="2,2,2,6">
          <!-- コピー元・移動元。 -->
          <Grid Height="20" Margin="0,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="62" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblSource" Grid.Column="0" Text="コピー元" Foreground="{DynamicResource MutedText}" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text=":" Foreground="{DynamicResource MutedText}" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center">
              <Run x:Name="TxtSource" Text="autoexec.bat" Foreground="{DynamicResource HighlightText}" />
            </TextBlock>
          </Grid>

          <!-- コピー先・移動先。 -->
          <Grid Height="20" Margin="0,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="62" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblDest" Grid.Column="0" Text="コピー先" Foreground="{DynamicResource MutedText}" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text=":" Foreground="{DynamicResource MutedText}" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center">
              <Run x:Name="TxtDest" Text="autoexec.bat" Foreground="{DynamicResource HighlightText}" />
            </TextBlock>
          </Grid>

          <!-- 内容・サイズ・日時の比較結果。 -->
          <Grid Height="20" Margin="0,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="62" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="判定情報" Foreground="{DynamicResource MutedText}" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text=":" Foreground="{DynamicResource MutedText}" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center">
              <Run Text="[" Foreground="{DynamicResource MutedText}" />
              <Run x:Name="TxtStatus" Text="完全一致" Foreground="{DynamicResource HighlightText}" FontWeight="SemiBold" />
              <Run Text=" │ " Foreground="{DynamicResource MutedText}" />
              <Run x:Name="TxtSize" Text="同一サイズ" Foreground="{DynamicResource PaneText}" />
              <Run Text=" │ " Foreground="{DynamicResource MutedText}" />
              <Run x:Name="TxtTime" Text="同一日時" Foreground="{DynamicResource PaneText}" />
              <Run Text="]" Foreground="{DynamicResource MutedText}" />
            </TextBlock>
          </Grid>
        </StackPanel>

        <!-- 区切り線。 -->
        <Border Height="1" Background="{DynamicResource DarkPurpleHighlight}" Margin="0,2,0,6" SnapsToDevicePixels="True" />

        <!-- 処理方法の選択肢。Tagの値でどの処理かを区別する。 -->
        <StackPanel x:Name="OptionsPanel" Margin="0,0,0,4">
          <!-- O：強制上書き。 -->
          <Border x:Name="OptionO" Tag="Overwrite" Height="22" Padding="6,0" BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter" SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="O" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="13" />
              <TextBlock x:Name="TxtOptionO" Grid.Column="1" Text="強制上書き (上書きコピー)" Foreground="{DynamicResource PaneText}" FontSize="13" />
            </Grid>
          </Border>

          <!-- U：コピー元が新しいときだけ更新。 -->
          <Border x:Name="OptionU" Tag="Update" Height="22" Padding="6,0" BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter" SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="U" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="13" />
              <TextBlock x:Name="TxtOptionU" Grid.Column="1" Text="更新 (コピー元が新しい場合のみ)" Foreground="{DynamicResource PaneText}" FontSize="13" />
            </Grid>
          </Border>

          <!-- R：名前を変えてコピー。 -->
          <Border x:Name="OptionR" Tag="Rename" Height="22" Padding="6,0" BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter" SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="R" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="13" />
              <TextBlock x:Name="TxtOptionR" Grid.Column="1" Text="リネームコピー (名前変更)" Foreground="{DynamicResource PaneText}" FontSize="13" />
            </Grid>
          </Border>

          <!-- N：コピーしない。 -->
          <Border x:Name="OptionN" Tag="Skip" Height="22" Padding="6,0" BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter" SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="N" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="13" />
              <TextBlock x:Name="TxtOptionN" Grid.Column="1" Text="コピーしない (スキップ)" Foreground="{DynamicResource PaneText}" FontSize="13" />
            </Grid>
          </Border>

          <!-- A：自動で連番を付けてコピー。 -->
          <Border x:Name="OptionA" Tag="AutoRename" Height="22" Padding="6,0" BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter" SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="A" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="13" />
              <TextBlock x:Name="TxtOptionA" Grid.Column="1" Text="自動連番コピー (名前_1等)" Foreground="{DynamicResource PaneText}" FontSize="13" />
            </Grid>
          </Border>

          <!-- C：処理全体を中止。 -->
          <Border x:Name="OptionC" Tag="Cancel" Height="22" Padding="6,0" BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter" SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="C" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="13" />
              <TextBlock Grid.Column="1" Text="処理中止 (キャンセル)" Foreground="{DynamicResource PaneText}" FontSize="13" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- 名前変更の入力欄。普段は隠し、Rを選んだときに選択肢と入れ替えて出す。 -->
        <Border x:Name="RenamePanel" Visibility="Collapsed" Background="{DynamicResource DialogInsetBackground}" BorderBrush="{DynamicResource AccentText}" BorderThickness="1" Padding="6,4" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock Text="新しいファイル名を入力してください:" Foreground="{DynamicResource AccentText}" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="RenameTextBox"
                     Background="{DynamicResource DialogBackground}"
                     Foreground="{DynamicResource PaneText}"
                     CaretBrush="{DynamicResource HighlightText}"
                     BorderBrush="{DynamicResource HighlightText}"
                     BorderThickness="1"
                     Padding="4,2"
                     FontSize="13"
                     FontFamily="Consolas, BIZ UDGothic, MS Gothic"
                     KeyDown="RenameTextBox_KeyDown" />
            <DockPanel Margin="0,4,0,0">
              <TextBlock Text="[Enter] 確定   [Esc] 戻る" Foreground="{DynamicResource MutedText}" FontSize="11" />
              <Button Content="確定" HorizontalAlignment="Right" Width="50" Click="RenameConfirm_Click"
                      Background="{DynamicResource FunctionButtonBackground}" Foreground="{DynamicResource FunctionButtonForeground}" />
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- 下部のキーヘルプ。 -->
        <controls:RetroDialogKeyHelp Text="※ Shift+キー で以降すべてに適用  [Enter] 決定  [Esc] 中止" />

      </StackPanel>
    </DockPanel>
  </Border>
</controls:RetroDialogWindow>
