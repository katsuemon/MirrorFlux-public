<controls:RetroDialogWindow x:Class="MirrorFlux.SortDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MirrorFlux.Controls"
        Title="ソート設定"
        Width="420"
        Foreground="{DynamicResource PaneText}"
        InputMethod.IsInputMethodEnabled="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

  <!-- ファイル一覧の並び順を選ぶダイアログ。外枠は2pxの強調色で囲む。 -->
  <Border BorderBrush="{DynamicResource HighlightText}" BorderThickness="2" Background="{DynamicResource DialogBackground}" Padding="0">
    <DockPanel LastChildFill="True">

      <!-- 共通のダイアログ見出し。 -->
      <controls:RetroDialogHeader x:Name="DialogHeader" DockPanel.Dock="Top" TitleText="ソート設定" />

      <!-- 本文。 -->
      <StackPanel Margin="16,12,16,14">
        <TextBlock x:Name="TargetPaneText"
                   Text="表示ソート順を選択してください:"
                   Foreground="{DynamicResource PaneText}"
                   FontSize="14"
                   Margin="0,0,0,10" />

        <!-- 並び順の選択肢。4行×2列で、左列が▲昇順、右列が▼降順。 -->
        <Grid x:Name="OptionsGrid" Margin="12,0,12,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
            <RowDefinition Height="28" />
          </Grid.RowDefinitions>

          <!-- 1行目：名前順。 -->
          <Border x:Name="OptionNameAsc" Grid.Row="0" Grid.Column="0" Height="24" Padding="10,0"
                  BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand"
                  Tag="Name:True" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter"
                  SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="N" Foreground="{DynamicResource AccentText}" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="名前▲" Foreground="{DynamicResource PaneText}" />
            </Grid>
          </Border>

          <Border x:Name="OptionNameDesc" Grid.Row="0" Grid.Column="2" Height="24" Padding="10,0"
                  BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand"
                  Tag="Name:False" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter"
                  SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="R" Foreground="{DynamicResource AccentText}" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="名前▼" Foreground="{DynamicResource PaneText}" />
            </Grid>
          </Border>

          <!-- 2行目：拡張子順。 -->
          <Border x:Name="OptionTypeAsc" Grid.Row="1" Grid.Column="0" Height="24" Padding="10,0"
                  BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand"
                  Tag="Type:True" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter"
                  SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="E" Foreground="{DynamicResource AccentText}" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="拡張子▲" Foreground="{DynamicResource PaneText}" />
            </Grid>
          </Border>

          <Border x:Name="OptionTypeDesc" Grid.Row="1" Grid.Column="2" Height="24" Padding="10,0"
                  BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand"
                  Tag="Type:False" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter"
                  SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="X" Foreground="{DynamicResource AccentText}" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="拡張子▼" Foreground="{DynamicResource PaneText}" />
            </Grid>
          </Border>

          <!-- 3行目：サイズ順。 -->
          <Border x:Name="OptionSizeAsc" Grid.Row="2" Grid.Column="0" Height="24" Padding="10,0"
                  BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand"
                  Tag="Size:True" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter"
                  SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Z" Foreground="{DynamicResource AccentText}" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="サイズ▲" Foreground="{DynamicResource PaneText}" />
            </Grid>
          </Border>

          <Border x:Name="OptionSizeDesc" Grid.Row="2" Grid.Column="2" Height="24" Padding="10,0"
                  BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand"
                  Tag="Size:False" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter"
                  SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="S" Foreground="{DynamicResource AccentText}" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="サイズ▼" Foreground="{DynamicResource PaneText}" />
            </Grid>
          </Border>

          <!-- 4行目：日時順。 -->
          <Border x:Name="OptionDateAsc" Grid.Row="3" Grid.Column="0" Height="24" Padding="10,0"
                  BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand"
                  Tag="Date:True" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter"
                  SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="T" Foreground="{DynamicResource AccentText}" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="日時▲" Foreground="{DynamicResource PaneText}" />
            </Grid>
          </Border>

          <Border x:Name="OptionDateDesc" Grid.Row="3" Grid.Column="2" Height="24" Padding="10,0"
                  BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand"
                  Tag="Date:False" MouseLeftButtonDown="Option_MouseLeftButtonDown" MouseEnter="Option_MouseEnter"
                  SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="D" Foreground="{DynamicResource AccentText}" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="日時▼" Foreground="{DynamicResource PaneText}" />
            </Grid>
          </Border>
        </Grid>

        <!-- 「フォルダを上に集める」の切り替え。既定はオン。 -->
        <Border Height="1" Background="{DynamicResource DarkPurpleHighlight}" Margin="12,0,12,6" SnapsToDevicePixels="True" />
        <Border x:Name="OptionDirsFirst" Height="26" Margin="12,0,12,8" Padding="10,0"
                BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand"
                MouseLeftButtonDown="DirsFirst_MouseLeftButtonDown"
                SnapsToDevicePixels="True">
          <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="26" />
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="F" Foreground="{DynamicResource AccentText}" FontWeight="Bold" />
            <TextBlock x:Name="DirsFirstCheckText" Grid.Column="1" Text="[✓]" Foreground="{DynamicResource HighlightText}" FontWeight="Bold" />
            <TextBlock Grid.Column="2" Text="フォルダを上に集める" Foreground="{DynamicResource PaneText}" />
          </Grid>
        </Border>

        <!-- 下部のキーヘルプ。 -->
        <controls:RetroDialogKeyHelp Text="[Enter] 決定   [F/Space] フォルダ上   [Esc] 中止" />
      </StackPanel>
    </DockPanel>
  </Border>
</controls:RetroDialogWindow>
