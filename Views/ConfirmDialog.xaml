<controls:RetroDialogWindow x:Class="MirrorFlux.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MirrorFlux.Controls"
        Width="520"
        Foreground="{DynamicResource PaneText}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

  <!-- コピー・移動・削除・終了の確認ダイアログ。文言と詳細の行は ConfirmDialog.For* が決める。 -->
  <!-- 外枠。2pxの強調色で囲む。 -->
  <Border BorderBrush="{DynamicResource HighlightText}" BorderThickness="2" Background="{DynamicResource DialogBackground}" Padding="0">
    <DockPanel LastChildFill="True">

      <!-- 共通のダイアログ見出し。横幅いっぱいに置く。 -->
      <controls:RetroDialogHeader x:Name="Header" DockPanel.Dock="Top" />

      <!-- 本文。 -->
      <StackPanel Margin="16,12,16,14">
        <!-- 確認の問いかけ。 -->
        <TextBlock x:Name="PromptText"
                   Foreground="{DynamicResource PaneText}"
                   FontSize="14"
                   Margin="0,0,0,10" />

        <!-- 詳細の表。行はコードで追加する。 -->
        <StackPanel x:Name="DetailRows" Margin="12,0,12,12" />

        <!-- 区切り線。 -->
        <Border Height="1" Background="{DynamicResource DarkPurpleHighlight}" Margin="0,0,0,10" SnapsToDevicePixels="True" />

        <!-- [Y] / [N] の選択肢。 -->
        <Grid Margin="12,0,12,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Y：実行する。 -->
          <Border x:Name="OptionYes" Grid.Column="0" Height="24" Padding="8,0"
                  BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="OptionYes_Click" MouseEnter="OptionYes_MouseEnter"
                  SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Y" Foreground="{DynamicResource AccentText}" FontWeight="Bold" />
              <TextBlock x:Name="YesText" Grid.Column="1" Foreground="{DynamicResource PaneText}" />
            </Grid>
          </Border>

          <!-- N：中止する。 -->
          <Border x:Name="OptionNo" Grid.Column="2" Height="24" Padding="8,0"
                  BorderThickness="0,0,0,1.5" BorderBrush="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="OptionNo_Click" MouseEnter="OptionNo_MouseEnter"
                  SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="N" Foreground="{DynamicResource AccentText}" FontWeight="Bold" />
              <TextBlock x:Name="NoText" Grid.Column="1" Foreground="{DynamicResource PaneText}" />
            </Grid>
          </Border>
        </Grid>

        <!-- 下部のキーヘルプ。 -->
        <controls:RetroDialogKeyHelp x:Name="KeyHelp" />
      </StackPanel>
    </DockPanel>
  </Border>
</controls:RetroDialogWindow>
