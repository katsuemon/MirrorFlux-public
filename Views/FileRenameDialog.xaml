<controls:RetroDialogWindow x:Class="MirrorFlux.FileRenameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MirrorFlux.Controls"
    Title="項目情報の編集" Width="460" Foreground="{DynamicResource PaneText}"
    Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
  <!-- 項目情報の編集ダイアログ。名前・属性・更新日時を変える。 -->
  <controls:RetroDialogWindow.Resources>
    <!-- ラベルの縦位置、操作ボタン、属性の「あり／なし」切り替えボタンのスタイル。 -->
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PaneText}" />
      <Setter Property="Background" Value="{DynamicResource DialogBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InactiveBorder}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,2,6,2" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1.5" Padding="{TemplateBinding Padding}">
            <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource InteractionSelectionBackground}" /><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource HighlightText}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#121828" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AttributeToggle" TargetType="ToggleButton">
      <Setter Property="Content" Value="[ なし ]" />
      <Setter Property="Foreground" Value="{DynamicResource HighlightText}" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Frame" Background="{DynamicResource DialogBackground}" BorderBrush="{DynamicResource InactiveBorder}" BorderThickness="0,0,0,1.5" Padding="8,3">
          <ContentPresenter HorizontalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource InteractionSelectionBackground}" /><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource HighlightText}" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#121828" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="[ あり ]" /></Trigger></Style.Triggers>
    </Style>
  </controls:RetroDialogWindow.Resources>
  <Border BorderBrush="{DynamicResource HighlightText}" BorderThickness="2" Background="{DynamicResource DialogBackground}">
    <DockPanel>
      <controls:RetroDialogHeader x:Name="DialogHeader" DockPanel.Dock="Top" TitleText="項目情報の編集" />
      <StackPanel Margin="18,12,18,14">
        <!-- 名前と大文字・小文字変換の行。 -->
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="148" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition x:Name="ExtensionRow" Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="NameLabel" Text="ファイル名" />
          <TextBlock Grid.Column="1" Grid.ColumnSpan="2" x:Name="OriginalName" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="1" Text="変更後" />
          <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox" Width="288" HorizontalAlignment="Right" Style="{StaticResource RetroDialogTextBoxStyle}" />
          <TextBlock Grid.Row="2" Text="名前全体" />
          <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Button Style="{StaticResource ActionButton}" Content="大文字(_U)" x:Name="NameUpperButton" Tag="all:upper" Click="Case_Click" />
            <Button Style="{StaticResource ActionButton}" Content="小文字(_L)" x:Name="NameLowerButton" Tag="all:lower" Click="Case_Click" />
            <Button Style="{StaticResource ActionButton}" Content="語頭大文字(_C)" x:Name="NameCapitalButton" Tag="all:capital" Click="Case_Click" />
          </StackPanel>
          <TextBlock x:Name="ExtensionLabel" Grid.Row="3" Text="拡張子" />
          <StackPanel x:Name="ExtensionButtonsPanel" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Button Style="{StaticResource ActionButton}" Content="大文字(_E)" x:Name="ExtensionUpperButton" Tag="ext:upper" Click="Case_Click" />
            <Button Style="{StaticResource ActionButton}" Content="小文字(_O)" x:Name="ExtensionLowerButton" Tag="ext:lower" Click="Case_Click" />
            <Button Style="{StaticResource ActionButton}" Content="語頭大文字(_P)" x:Name="ExtensionCapitalButton" Tag="ext:capital" Click="Case_Click" />
          </StackPanel>
          <!-- 属性と更新日時の行。左に現在の値、右に変更後の値を置く。 -->
          <TextBlock Grid.Row="4" Text="属性・更新日時" Foreground="{DynamicResource MutedText}" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="現在" Foreground="{DynamicResource MutedText}" />
          <TextBlock Grid.Row="4" Grid.Column="2" Text="変更後" Foreground="{DynamicResource MutedText}" />
        <TextBlock Grid.Row="5" Text="読み取り専用" />
        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="CurrentReadOnly" Foreground="{DynamicResource MutedText}" />
        <ToggleButton Grid.Row="5" Grid.Column="2" x:Name="ReadOnlyToggle" Width="96" HorizontalAlignment="Left" Style="{StaticResource AttributeToggle}" />
        <TextBlock Grid.Row="6" Text="隠しファイル" />
        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="CurrentHidden" Foreground="{DynamicResource MutedText}" />
        <ToggleButton Grid.Row="6" Grid.Column="2" x:Name="HiddenToggle" Width="96" HorizontalAlignment="Left" Style="{StaticResource AttributeToggle}" />
        <TextBlock Grid.Row="7" Text="システム" />
        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="CurrentSystem" Foreground="{DynamicResource MutedText}" />
        <ToggleButton Grid.Row="7" Grid.Column="2" x:Name="SystemToggle" Width="96" HorizontalAlignment="Left" Style="{StaticResource AttributeToggle}" />
          <TextBlock Grid.Row="8" Text="実行属性" Foreground="{DynamicResource MutedText}" />
          <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Text="対象外（Windowsには同等の属性なし）" Foreground="{DynamicResource MutedText}" FontSize="12" />
          <TextBlock Grid.Row="9" Text="更新日" />
          <TextBlock Grid.Row="9" Grid.Column="1" x:Name="CurrentDate" Foreground="{DynamicResource MutedText}" />
          <TextBox Grid.Row="9" Grid.Column="2" x:Name="DateBox" Width="140" HorizontalAlignment="Left" Style="{StaticResource RetroDialogTextBoxStyle}" />
          <TextBlock Grid.Row="10" Text="更新時刻" />
          <TextBlock Grid.Row="10" Grid.Column="1" x:Name="CurrentTime" Foreground="{DynamicResource MutedText}" />
          <TextBox Grid.Row="10" Grid.Column="2" x:Name="TimeBox" Width="140" HorizontalAlignment="Left" Style="{StaticResource RetroDialogTextBoxStyle}" />
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />
        <Border Height="1" Background="{DynamicResource InactiveBorder}" Margin="0,10,0,6" />
        <!-- 適用・キャンセルボタンと下部のキーヘルプ。 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource ActionButton}" x:Name="ApplyButton" Content="変更を適用" Click="Apply_Click" />
          <Button Style="{StaticResource ActionButton}" x:Name="CancelButton" Content="キャンセル" IsCancel="True" />
        </StackPanel>
        <controls:RetroDialogKeyHelp Text="[↑↓] 項目移動  [←→] 選択・属性変更  [Enter] 決定  [Esc] 中止" Margin="0,8,0,0" />
        <TextBlock Text="カーソル位置の1項目のみ対象（マークによる一括変更なし）" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedText}" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>
  </Border>
</controls:RetroDialogWindow>
