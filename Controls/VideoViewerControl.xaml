<UserControl x:Class="MirrorFlux.Controls.VideoViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" Background="Black">
    <!-- 動画ビューア。Windows の再生機能で動画を表示し、下にシークバーと時間を置く。 -->
    <UserControl.Resources>
        <!-- シークバーの再生済み・未再生の模様。サウンドビューアの操作表示と同じ、幅2×高さ8の棒を4DIP間隔で並べる。 -->
        <DrawingBrush x:Key="VideoSeekPlayed" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,4,8"
                      ViewboxUnits="Absolute" Viewbox="0,0,4,8" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource HighlightText}" Geometry="M0,0 H2 V8 H0 Z"/>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="VideoSeekRemaining" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,4,8"
                      ViewboxUnits="Absolute" Viewbox="0,0,4,8" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource MutedText}" Geometry="M0,0 H2 V8 H0 Z"/>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- シークバーの溝。背景の模様だけを描くボタン。 -->
        <Style x:Key="VideoSeekTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- シークバー本体。左が再生済み、右が未再生で、つまみはマウスを乗せたりドラッグしたりすると色が変わる。 -->
        <Style x:Key="VideoSeekSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="SeekRoot" Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource VideoSeekTrackButton}"
                                                  Background="{StaticResource VideoSeekPlayed}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="8" Height="18" Focusable="False" VerticalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="SeekThumb" CornerRadius="4"
                                                        Background="{DynamicResource AccentText}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SeekThumb" Property="Background" Value="{DynamicResource MusicTransportHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="SeekThumb" Property="Background" Value="{DynamicResource HighlightText}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource VideoSeekTrackButton}"
                                                  Background="{StaticResource VideoSeekRemaining}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SeekRoot" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 動画の表示面と、読み込み中・エラーのメッセージ。 -->
        <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Close"
                      Stretch="Uniform" ScrubbingEnabled="True" Focusable="False"
                      MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"/>
        <TextBlock x:Name="Message" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="24" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryText}"
                   IsHitTestVisible="False"/>
        <!-- キー一覧のヘルプ。ヘルプキーで表示を切り替える。 -->
        <Border x:Name="HelpPanel" Visibility="Collapsed" Margin="24"
                Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource InactiveBorder}"
                BorderThickness="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <TextBlock x:Name="HelpText" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
        <!-- 下段。シークバーと「経過 / 長さ | 音量」の表示。 -->
        <Grid Grid.Row="1" Margin="12,6" Background="{DynamicResource PanelBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="PositionSlider" Style="{StaticResource VideoSeekSlider}" Minimum="0" Maximum="1" IsEnabled="False"
                    Focusable="False" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                    ValueChanged="OnPositionChanged"/>
            <TextBlock x:Name="TimeText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryText}"/>
        </Grid>
    </Grid>
</UserControl>
