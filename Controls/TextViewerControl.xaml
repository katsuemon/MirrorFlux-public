<UserControl x:Class="MirrorFlux.Controls.TextViewerControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MirrorFlux.Controls"
 xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
 Background="{DynamicResource ScreenBackground}" Foreground="{DynamicResource PaneText}">
 <!-- テキストビューア。上から検索バー、本文（テキスト・HEX・Markdown）とミニマップ、HEXの値表示欄を並べる。 -->
 <UserControl.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource DarkPurpleBackground}"/><Setter Property="Foreground" Value="{DynamicResource PaneText}"/><Setter Property="BorderBrush" Value="{DynamicResource InactiveBorder}"/><Setter Property="Padding" Value="5,2"/><Setter Property="Margin" Value="2,0"/><Setter Property="Focusable" Value="False"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource PaneText}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- 検索バー。Ctrl+F や / で開き、検索オプションと件数を表示する。 -->
  <Border x:Name="SearchBar" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource DarkPurpleBackground}" BorderBrush="{DynamicResource HighlightText}" BorderThickness="0,0,0,1" Padding="5">
   <DockPanel>
    <TextBlock DockPanel.Dock="Right" Text="F3/F4 次/前  Esc 閉じる" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource MutedText}"/>
    <TextBlock x:Name="SearchInfo" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0"/>
    <CheckBox x:Name="ByteSearchToggle" DockPanel.Dock="Right" Content="バイト列" Visibility="Collapsed" Click="SearchOptions_Click"/>
    <CheckBox x:Name="RegexToggle" DockPanel.Dock="Right" Content="正規表現" Click="SearchOptions_Click"/>
    <CheckBox x:Name="CaseToggle" DockPanel.Dock="Right" Content="大文字小文字" Click="SearchOptions_Click"/>
    <TextBox x:Name="SearchInput" MinWidth="100" Background="{DynamicResource ViewerBlack}" Foreground="{DynamicResource PaneText}" CaretBrush="{DynamicResource HighlightText}" TextChanged="Search_TextChanged" PreviewKeyDown="SearchInput_KeyDown"/>
   </DockPanel>
  </Border>
  <!-- 本文。テキスト・HEX・Markdownのどれか1つを表示し、右にミニマップを置く。 -->
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ae:TextEditor x:Name="Editor" IsReadOnly="True" ShowLineNumbers="True" WordWrap="True" Background="{DynamicResource ViewerBlack}" Foreground="{DynamicResource PaneText}" LineNumbersForeground="{DynamicResource MutedText}" BorderThickness="0" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="4,0"/>
   <local:HexViewerControl x:Name="HexView" Visibility="Collapsed"/>
   <FlowDocumentScrollViewer x:Name="MarkdownViewer" Background="{DynamicResource ViewerBlack}" Foreground="{DynamicResource PaneText}" BorderThickness="0" Padding="20,10" IsToolBarVisible="False" Visibility="Collapsed"/>
   <local:TextMinimap x:Name="Minimap" Grid.Column="1" Margin="4,0,0,0"/>
   <!-- 行番号・アドレスの移動欄。 -->
   <Border x:Name="JumpOverlay" VerticalAlignment="Top" Background="{DynamicResource DarkPurpleBackground}" BorderBrush="{DynamicResource HighlightText}" BorderThickness="1" Padding="8" Visibility="Collapsed">
    <DockPanel><TextBlock x:Name="JumpLabel" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="JumpInput" Background="{DynamicResource ViewerBlack}" Foreground="{DynamicResource PaneText}" CaretBrush="{DynamicResource HighlightText}" PreviewKeyDown="JumpInput_KeyDown"/></DockPanel>
   </Border>
  </Grid>
  <!-- HEX表示でキャレット位置の値を表示する欄。 -->
  <TextBlock x:Name="Inspector" Grid.Row="2" Background="{DynamicResource TextViewerBackground}" Foreground="{DynamicResource MutedText}" Padding="6,3" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
 </Grid>
</UserControl>
