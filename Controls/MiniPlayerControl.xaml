<UserControl x:Class="MirrorFlux.Controls.MiniPlayerControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MirrorFlux.Controls" Width="323" Height="120" Background="{DynamicResource ViewerBlack}" BorderBrush="{DynamicResource MiniPlayerBorder}" BorderThickness="1,0,0,0"
 FontFamily="Consolas, BIZ UDGothic, MS Gothic" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <!-- サウンドバー。再生中の曲の状態・時間・操作ボタンと、鍵盤とレベルメーター、またはスペクトラムを小さく表示する。 -->
 <UserControl.Resources>
  <!-- 操作ボタン共通の見た目。フォーカスを取らない小さな角丸ボタン。 -->
  <Style TargetType="Button"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="19"/><Setter Property="Margin" Value="2,0,0,0"/><Setter Property="Background" Value="{DynamicResource MiniPlayerButtonBackground}"/><Setter Property="Foreground" Value="{DynamicResource MiniPlayerButtonForeground}"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource MiniPlayerButtonBorder}" BorderThickness="1" CornerRadius="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource MiniPlayerButtonHover}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MusicMeterLit}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource MusicMeterPeak}"/><Setter Property="Foreground" Value="{DynamicResource ViewerWhite}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid x:Name="LayoutRoot" Margin="3,2,4,0"><Grid.RowDefinitions><RowDefinition Height="21"/><RowDefinition/></Grid.RowDefinitions>
  <!-- 上段。左に再生状態と時間、右に曲番号・曲送り・一時停止・停止・サウンドビューア表示のボタン。 -->
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <!-- チップチューン用の状態と時間。 -->
   <StackPanel x:Name="ChiptuneHeaderPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
    <TextBlock x:Name="PlayStatusText" Text="PLAY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MusicCyan}" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <local:MusicSevenSegmentDisplay x:Name="SevenSegmentTime" DigitHeight="13" DigitWidth="7" SegmentThickness="1.5" DigitSpacing="2" ColonWidth="2.5" DigitsAlignment="Left" ShowIndicator="False" Foreground="{DynamicResource MusicSevenSegment}" VerticalAlignment="Center"/>
   </StackPanel>
   <!-- スペクトラムだけを出す音声ファイル用の状態と時間。 -->
   <StackPanel x:Name="StreamHeaderPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed">
    <TextBlock x:Name="StreamPlayStatusText" Text="PLAY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MusicCyan}" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <local:MusicSevenSegmentDisplay x:Name="StreamSevenSegmentTime" DigitHeight="13" DigitWidth="7" SegmentThickness="1.5" DigitSpacing="2" ColonWidth="2.5" DigitsAlignment="Left" ShowIndicator="False" Foreground="{DynamicResource MusicSevenSegment}" VerticalAlignment="Center"/>
   </StackPanel>
   <!-- 曲番号と操作ボタン。 -->
   <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><StackPanel x:Name="SubsongPanel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,3,0" Background="{DynamicResource ViewerBlack}"><local:MusicSevenSegmentDisplay x:Name="SubsongText" Width="48" Height="15" Text="01/01" DigitHeight="13" DigitWidth="7" SegmentThickness="1.5" DigitSpacing="2" ColonWidth="2.5" DigitsAlignment="Center" ShowIndicator="False" Foreground="{DynamicResource MusicSevenSegment}" VerticalAlignment="Center"/></StackPanel><StackPanel x:Name="TrackButtonsPanel" Orientation="Horizontal" Visibility="Collapsed"><Button x:Name="PreviousTrackButton" Width="18" Margin="1,0,0,0" Click="OnPreviousTrackClick"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Text="&#xE76B;"/></Button><Button x:Name="NextTrackButton" Width="18" Margin="0" Click="OnNextTrackClick"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Text="&#xE76C;"/></Button></StackPanel><Button x:Name="PauseButton" Click="OnPauseClick"><TextBlock x:Name="PauseIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Text="&#xE769;"/></Button><Button Click="OnStopClick"><TextBlock x:Name="StopIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Text="&#xE71A;"/></Button><Button x:Name="ExpandButton" Click="OnExpandClick"><TextBlock x:Name="ExpandIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Text="&#xE740;"/></Button></StackPanel>
  </Grid>
  <!-- チップチューン用の下段。曲名、鍵盤、チャンネルごとのレベルメーター、左右の出力。 -->
  <Grid x:Name="ChannelMonitorPanel" Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
   <local:MarqueeTextBlock x:Name="TitleText" Grid.Row="0" Width="315" Height="14" FontSize="11" Foreground="{DynamicResource MusicText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   <local:MusicKeyboardDisplay x:Name="KeyboardDisplay" Grid.Row="1" Width="315" Height="22" HorizontalAlignment="Right"/>
   <local:MusicMeterDisplay x:Name="MeterDisplay" FillWidth="True" Grid.Row="2" Width="315" HorizontalAlignment="Right" ShowPeakDockSegment="True" HiddenTopSegments="2" ChannelGapPixels="2"/>
   <local:MusicPanDisplay x:Name="PanDisplay" FillWidth="True" Grid.Row="3" Width="315" Height="18" HorizontalAlignment="Right"/>
  </Grid>
  <!-- 音声ファイル用の下段。曲名、シークバー、スペクトラム、周波数の目盛り。 -->
  <Grid x:Name="SpectrumPanel" Grid.Row="1" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/></Grid.RowDefinitions>
   <local:MarqueeTextBlock x:Name="StreamTitleText" Grid.Row="0" Width="315" Height="14" FontSize="11" Foreground="{DynamicResource MusicText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   <local:MusicSeekBarDisplay x:Name="MiniSeekBar" Grid.Row="1" Width="315" Height="14" HorizontalAlignment="Right" ReferenceChannels="24" ReferenceGapPixels="2"/>
   <local:MusicMeterDisplay x:Name="MiniSpectrumDisplay" FillWidth="True" Grid.Row="2" Width="315" HorizontalAlignment="Right" ShowPeakDockSegment="True" HiddenTopSegments="1" ChannelGapPixels="2"/>
   <local:MusicFrequencyRulerDisplay x:Name="MiniSpectrumRuler" FillWidth="True" FontSize="9" Grid.Row="3" Width="315" Height="14" HorizontalAlignment="Right" MinimumFrequency="10" MaximumFrequency="22050" ReferenceChannels="24" ReferenceGapPixels="2"/>
  </Grid>
 </Grid>
</UserControl>
