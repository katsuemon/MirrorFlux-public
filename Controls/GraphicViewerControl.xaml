<UserControl x:Class="MirrorFlux.Controls.GraphicViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Focusable="True"
             Background="{DynamicResource ScreenBackground}">
  <!-- グラフィックビューア。画像を表示するキャンバスに、読み込み中・エラーの表示を重ねる。 -->
  <UserControl.Resources>
    <!-- 透過部分の確認用に背景へ使う市松模様。 -->
    <DrawingBrush x:Key="CheckerboardBrush" Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="{DynamicResource ViewerChromeBackground}">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="0,0,16,16" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="{DynamicResource ViewerChromeBorder}">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <RectangleGeometry Rect="0,0,8,8" />
                <RectangleGeometry Rect="8,8,8,8" />
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </UserControl.Resources>

  <Grid x:Name="RootGrid"
        Background="{DynamicResource ScreenBackground}"
        ClipToBounds="True"
        Focusable="True"
        MouseWheel="RootGrid_MouseWheel">

    <!-- 画像を表示するキャンバス。拡大・移動は画像の枠に変換をかけて行う。 -->
    <Canvas x:Name="ImageCanvas"
            Background="Transparent"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ClipToBounds="True">
      <Border x:Name="ImageBorder"
              Background="Transparent"
              SnapsToDevicePixels="True">
        <Image x:Name="MainImage"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True"
               Stretch="Fill" />
      </Border>
    </Canvas>

    <!-- 読み込み中やエラーの表示。 -->
    <TextBlock x:Name="OverlayMessageText"
               Margin="24"
               TextWrapping="Wrap"
               TextAlignment="Center"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="{DynamicResource HighlightText}"
               FontSize="16"
               FontWeight="Bold"
               Visibility="Collapsed" />
  </Grid>
</UserControl>
