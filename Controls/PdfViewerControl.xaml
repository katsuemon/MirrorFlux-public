<UserControl x:Class="MirrorFlux.Controls.PdfViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Focusable="True"
             InputMethod.IsInputMethodEnabled="False"
             Background="{DynamicResource ScreenBackground}">
  <!-- PDFビューア。ページ画像を表示するキャンバスに、ページ番号のバッジと読み込み中・エラーの表示を重ねる。 -->
  <UserControl.Resources>
    <!-- 背景切替で使う市松模様。 -->
    <DrawingBrush x:Key="CheckerboardBrush" Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="{DynamicResource ViewerChromeBackground}">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="0,0,16,16" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="{DynamicResource ViewerChromeBorder}">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <RectangleGeometry Rect="0,0,8,8" />
                <RectangleGeometry Rect="8,8,8,8" />
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </UserControl.Resources>

  <Grid x:Name="RootGrid"
        Background="{DynamicResource ScreenBackground}"
        ClipToBounds="True"
        Focusable="True"
        MouseWheel="RootGrid_MouseWheel">

    <!-- ページ画像を表示するキャンバス。拡大・移動はページの枠に変換をかけて行う。 -->
    <Canvas x:Name="PageCanvas"
            Background="Transparent"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ClipToBounds="True">
      <Border x:Name="PageBorder"
              Background="{DynamicResource ViewerWhite}"
              BorderBrush="{DynamicResource MusicBorder}"
              BorderThickness="1"
              SnapsToDevicePixels="True">
        <Image x:Name="PageImage"
               RenderOptions.BitmapScalingMode="HighQuality"
               SnapsToDevicePixels="True"
               Stretch="Fill" />
      </Border>
    </Canvas>

    <!-- 右上のページ番号バッジ。 -->
    <Border x:Name="PageBadgeBorder"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,10,14,0"
            Padding="10,3"
            Background="{DynamicResource ViewerBadgeBackground}"
            BorderBrush="{DynamicResource HighlightText}"
            BorderThickness="1"
            Visibility="Collapsed">
      <TextBlock x:Name="PageBadgeText"
                 Foreground="{DynamicResource HighlightText}"
                 FontWeight="Bold"
                 FontSize="13" />
    </Border>

    <!-- 読み込み中やエラーの表示。 -->
    <TextBlock x:Name="OverlayMessageText"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="{DynamicResource HighlightText}"
               FontSize="16"
               FontWeight="Bold"
               Visibility="Collapsed" />
  </Grid>
</UserControl>

