<UserControl x:Class="MirrorFlux.Controls.RetroDialogHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MirrorFlux.Controls"
             Height="20"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
  <!-- ダイアログ上端の見出し帯。左右の横縞の間に題名を置く。帯全体を強調色で塗る。 -->
  <Border Background="{DynamicResource HighlightText}" Height="20"
          SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左の横縞。現在のDPIで物理2ピクセルの線と隙間を上下中央に描く。 -->
      <local:DialogHeaderStripes Grid.Column="0" />

      <!-- 中央の題名。強調色の地に黒の太字（通常の文字サイズ14）で書く。 -->
      <Border Grid.Column="1"
              Background="{DynamicResource HighlightText}"
              Padding="14,0"
              SnapsToDevicePixels="True" UseLayoutRounding="True">
        <TextBlock Text="{Binding TitleText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{DynamicResource ViewerBlack}"
                   FontWeight="Bold"
                   FontSize="14"
                   FontFamily="Consolas, BIZ UDGothic, MS Gothic"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />
      </Border>

      <!-- 右の横縞。左と同じく物理2ピクセルの線と隙間で描く。 -->
      <local:DialogHeaderStripes Grid.Column="2" />
    </Grid>
  </Border>
</UserControl>
